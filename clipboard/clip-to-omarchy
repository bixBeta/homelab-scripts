#!/bin/sh
# Send the selected text — or, with nothing selected, this Mac's clipboard —
# to omarchy's Wayland clipboard over Tailscale. Bound to ⌃⌥⌘C in Shortcuts.

# Shortcuts runs with a bare environment; without a UTF-8 locale, pbpaste
# mangles anything non-ASCII.
export LANG=en_US.UTF-8

# Text travels as argv, never spliced into the AppleScript source, so quotes
# or AppleScript syntax in the clipboard can't break or hijack the call.
notify() { # title subtitle message
  osascript \
    -e 'on run argv' \
    -e 'display notification (item 3 of argv) with title (item 1 of argv) subtitle (item 2 of argv)' \
    -e 'end run' \
    "$1" "$2" "$3" 2>/dev/null
}

# One-line preview: whitespace collapsed, cut at 60 characters (not bytes).
preview() {
  perl -CSD -0777 -ne 's/\s+/ /g; s/^ | $//g; print length($_) > 60 ? substr($_, 0, 60) . "\x{2026}" : $_' "$1"
}
chars() { perl -CSD -0777 -ne 'print length' "$1"; }

tmp=$(mktemp) || exit 1
trap 'rm -f "$tmp"' EXIT

# Run as a Quick Action, Shortcuts pipes the selected text to stdin, so one
# hotkey sends a selection without ⌘C. With no selection (or when run by
# hand from a terminal, where stdin is a tty) fall back to the clipboard.
source=Clipboard
if [ ! -t 0 ]; then
  cat >"$tmp"
  [ -s "$tmp" ] && source=Selection
fi
if [ "$source" = Clipboard ]; then
  pbpaste >"$tmp"
fi

# pbpaste yields nothing when the clipboard holds an image or file. Sending
# that would silently blank omarchy's clipboard, so stop instead.
if [ ! -s "$tmp" ]; then
  notify "Nothing sent" "No text selected or copied" "Select some text, or copy text, and try again."
  exit 1
fi

if ssh omarchy-clip copy <"$tmp" 2>/tmp/clip-to-omarchy.err; then
  notify "Sent to omarchy" "$source · $(chars "$tmp") characters" "$(preview "$tmp")"
else
  notify "Couldn't reach omarchy" "Nothing was sent" "Check Tailscale is on for both machines and omarchy is logged in."
  exit 1
fi
